VITE_ZENON_NODE_WS=wss://my.hc1node.com:35998
# alternative public node: wss://node.zenon.network:35998
VITE_ZENON_CHAIN_ID=1
VITE_PLASMA_BOT_URL=https://plazma.bot
VITE_NOSTR_RELAYS=wss://relay.primal.net,wss://nos.lol,wss://offchain.pub
VITE_NOSTR_INBOX_RELAY=wss://auth.nostr1.com
VITE_SHORT_LOCK_SECONDS=1800
VITE_LONG_LOCK_SECONDS=3600
# How far back a chain observation scans for an Unlock or Reclaim block.
VITE_HTLC_SCAN_PAGES=3
VITE_HTLC_PAGE_SIZE=100
# Offer a browser-extension wallet when one announces itself (docs/proposals/
# zenon-injected-provider.md). Off unless set to exactly 1.
VITE_INJECTED_WALLET=0
